{
  "expo": {
    "name": "mcring",
    "slug": "mcring",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "scheme": "mcring",
    "ios": {
      "bundleIdentifier": "dev.mcring.companion",
      "infoPlist": {
        "NSBluetoothAlwaysUsageDescription": "mcring talks to your camera ring over Bluetooth.",
        "UIBackgroundModes": [
          "bluetooth-central",
          "audio"
        ],
        "NSMicrophoneUsageDescription": "mcring records your spoken question while you hold the ring button."
      }
    },
    "android": {
      "package": "dev.mcring.companion",
      "permissions": [
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "plugins": [
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": true,
          "modes": [
            "central"
          ],
          "bluetoothAlwaysPermission": "mcring talks to your camera ring over Bluetooth."
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": "mcring records your spoken question while you hold the ring button."
        }
      ]
    ]
  }
}
