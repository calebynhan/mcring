# Copy to .env (or export) before running the backend.
ANTHROPIC_API_KEY=sk-ant-...
# OpenAI key: used for speech-to-text (default provider), server-side speech (optional) and the optional
# provider=openai answer path.
OPENAI_API_KEY=

# ---- the brain -----------------------------------------------------------------
MCRING_PROVIDER=anthropic
MCRING_ANTHROPIC_MODEL=claude-opus-5-5
MCRING_ANTHROPIC_EFFORT=medium
MCRING_OPENAI_MODEL=gpt-4.1-mini
# Server-side refusal fallbacks (Claude API only; set 0 on Bedrock/Vertex/Foundry)
MCRING_ANTHROPIC_FALLBACKS=1

# ---- voice in: speech-to-text for the wearer's question -------------------------
# openai = gpt-4o-mini-transcribe (needs OPENAI_API_KEY)
# local  = faster-whisper on this machine (pip install faster-whisper), model below
# none   = voice uploads answer 501 (text questions still work)
MCRING_STT_PROVIDER=openai
MCRING_STT_MODEL=gpt-4o-mini-transcribe
MCRING_WHISPER_MODEL=base.en
MCRING_WHISPER_DEVICE=cpu
MCRING_WHISPER_COMPUTE_TYPE=int8

# ---- voice out: speech synthesis for the answer ---------------------------------
# none   = the phone speaks `speech_text` with its own TTS engine (default)
# openai = gpt-4o-mini-tts; /v1/ask then returns speech by default (mp3 and/or 16 kHz ring ADPCM)
MCRING_TTS_PROVIDER=none
MCRING_TTS_MODEL=gpt-4o-mini-tts
MCRING_TTS_VOICE=alloy
MCRING_MAX_SPEECH_CHARS=1500

# ---- misc -------------------------------------------------------------------------
# Simple shared secret the companion must send as "Authorization: Bearer <token>" (empty = open)
MCRING_API_TOKEN=
# Max image edge in px before sending to the model (saves tokens; ring images are small anyway)
MCRING_MAX_IMAGE_EDGE=1024
MCRING_MAX_UPLOAD_BYTES=8388608
MCRING_SESSION_TTL_S=1800
