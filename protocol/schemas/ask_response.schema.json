{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mcring.dev/schemas/ask_response.schema.json",
  "title": "mcring AskResponse",
  "type": "object",
  "required": ["id", "answer", "short", "confidence", "provider", "model", "latency_ms"],
  "properties": {
    "id": {"type": "string"},
    "session_id": {"type": "string"},
    "answer": {"type": "string", "description": "Spoken / long answer, 1-3 sentences."},
    "short": {"type": "string", "description": "Morse-friendly answer: <= 32 chars, A-Z 0-9 space ? only."},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "subject": {"type": "string", "description": "Main subject, e.g. 'Digitalis purpurea (foxglove)'."},
    "warnings": {"type": "array", "items": {"type": "string"}, "description": "Safety-relevant notes (toxic, allergenic, ...)."},
    "morse": {
      "type": "object",
      "required": ["text", "unit_ms", "units"],
      "properties": {
        "text": {"type": "string"},
        "unit_ms": {"type": "integer"},
        "units": {"type": "array", "items": {"type": "integer", "minimum": 1, "maximum": 255}, "description": "Alternating ON/OFF durations in units, starting with ON."},
        "duration_ms": {"type": "integer"},
        "ring_packet_b64": {"type": "string", "description": "Ready-to-write Feedback characteristic payload (opcode 0x14 MORSE_UNITS)."}
      }
    },
    "speech": {
      "type": "object",
      "properties": {
        "mime": {"type": "string"},
        "audio_b64": {"type": "string"},
        "voice": {"type": "string"}
      }
    },
    "transcript": {"type": "string", "description": "If a voice question was uploaded, its transcription."},
    "provider": {"type": "string"},
    "model": {"type": "string"},
    "latency_ms": {"type": "integer"},
    "usage": {"type": "object", "properties": {"input_tokens": {"type": "integer"}, "output_tokens": {"type": "integer"}}}
  }
}
